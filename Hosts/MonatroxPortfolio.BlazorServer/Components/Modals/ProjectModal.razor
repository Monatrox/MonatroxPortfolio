<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h4" GutterBottom="true" Align="Align.Center">@Project.Name</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="5" md="4">
                <MudPaper Class="pa-4" Style="min-height:250px">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="220px" />
                </MudPaper>
                <MudText Align="Align.Center" Class="mt-2" Typo="Typo.caption">Project Image Placeholder</MudText>
            </MudItem>
            <MudItem xs="12" sm="7" md="8">
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" GutterBottom="true">Project Description</MudText>
                    @for (var i = 0; i < 4; i++) { <MudSkeleton /> }
                    <MudSkeleton Width="60%" />
                </MudPaper>
            </MudItem>
        </MudGrid>
        <MudPaper Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Additional Information</MudText>
            @for (var i = 0; i < 3; i++) { <MudSkeleton /> }
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Close()" Color="Color.Primary">OK</MudButton>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public ProjectDto Project { get; set; } = null!;
}
