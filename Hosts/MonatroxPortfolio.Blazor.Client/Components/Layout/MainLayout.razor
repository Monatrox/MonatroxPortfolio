@inherits LayoutComponentBase

<MudThemeProvider Theme="Theme" IsDarkMode="_gamerView" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="portfolio-shell" data-renderer="@RendererInfo.Name" data-view="@(_gamerView ? "gamer" : "professional")" data-gamer-preview="@(_gamerView ? _gamerPreview : null)">
    <a class="skip-link" href="#main-content" @onclick="FocusMainAsync" @onclick:preventDefault>Skip to content</a>
    <MudAppBar Fixed="false" Elevation="0" Class="site-header">
        <div class="site-header-inner">
            <MudLink Href="/" Underline="Underline.None" Class="site-brand" aria-label="Home">
                <span class="brand-mark">
                    <MudImage Src="Content/Images/MX Abstract Logo Cleaned_Letters_DarkTheme.png" Alt="MX logo" ObjectFit="ObjectFit.Contain" />
                </span>
                <span class="brand-wordmark">@(_gamerView ? "Monatrox" : "Zac Taylor")</span>
            </MudLink>
            <nav class="site-nav" aria-label="Sections">
                <MudLink Href="/#projects" Underline="Underline.None" Color="Color.Inherit">Work<span aria-hidden="true">01</span></MudLink>
                <MudLink Href="/#skills" Underline="Underline.None" Color="Color.Inherit">Expertise<span aria-hidden="true">02</span></MudLink>
                <MudLink Href="/#background" Underline="Underline.None" Color="Color.Inherit">Background<span aria-hidden="true">03</span></MudLink>
            </nav>
        </div>
    </MudAppBar>
    <main class="portfolio-main" id="main-content" tabindex="-1" @ref="_main">
        <CascadingValue Name="GamerView" Value="_gamerView">
            <CascadingValue Name="SelectView" Value="EventCallback.Factory.Create<bool>(this, SelectView)">
                @Body
            </CascadingValue>
        </CascadingValue>
    </main>
    <footer class="site-footer">
        <span>Zac Taylor <span aria-hidden="true">/</span> Monatrox</span>
        <MudLink Href="#main-content" OnClick="FocusMainAsync" Underline="Underline.None" role="link">Back to top ↑</MudLink>
    </footer>
</MudLayout>

@if (_gamerView)
{
    <aside class="gamer-preview-picker" aria-label="Gamer layout previews">
        <div class="gamer-preview-caption"><span>Gamer layouts · preview</span><span aria-live="polite">@GamerPreviews.First(preview => preview.Id == _gamerPreview).Name</span></div>
        <div class="gamer-preview-options" role="group" aria-label="Choose gamer layout">
            @foreach (var preview in GamerPreviews)
            {
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="gamer-preview-option"
                           aria-pressed="@((_gamerPreview == preview.Id).ToString().ToLowerInvariant())"
                           aria-label="@($"Preview {preview.Name} gamer layout")" OnClick="() => _gamerPreview = preview.Id">@preview.Name</MudButton>
            }
        </div>
    </aside>
}

<div id="blazor-error-ui" role="alert">
    Unexpected error. <a href="">Reload portfolio</a>
</div>

@code {
    private bool _gamerView;
    private string _gamerPreview = "clawmark";
    private static readonly (string Id, string Name)[] GamerPreviews =
    [
        ("clawmark", "Clawmark"), ("neon", "Neon"), ("arcade", "Arcade"),
        ("manuscript", "Manuscript"), ("tactical", "Tactical"), ("crt", "CRT")
    ];
    private ElementReference _main;
    private void SelectView(bool gamer) => _gamerView = gamer;
    private async Task FocusMainAsync() => await _main.FocusAsync();

    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Background = "#F5F3EC", Surface = "#FCFBF7", BackgroundGray = "#ECEDE3",
            Primary = "#526B17", PrimaryContrastText = "#FFFFFF", Secondary = "#A8D438",
            TextPrimary = "#252B23", TextSecondary = "#62695C",
            AppbarBackground = "#F5F3EC", AppbarText = "#252B23",
            Info = "#1F617F", Error = "#A73524", Success = "#2F641D",
            Divider = "#D5D8CB", LinesDefault = "#D5D8CB"
        },
        PaletteDark = new PaletteDark()
        {
            Background = "#181A18", Surface = "#232720", BackgroundGray = "#1F251B",
            Primary = "#B0DC4A", PrimaryContrastText = "#252B23", Secondary = "#A8D438",
            TextPrimary = "#EEF1E9", TextSecondary = "#BBC4B1",
            AppbarBackground = "#181A18", AppbarText = "#EEF1E9",
            Info = "#8AC7F0", Error = "#FFB4A8", Success = "#B4DA91",
            Divider = "#454E3F", LinesDefault = "#454E3F"
        },
        LayoutProperties = new() { DefaultBorderRadius = "3px" }
    };
}
